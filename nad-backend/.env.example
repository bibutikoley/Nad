# --- LiveKit server (docker-compose.yml reads these for the container) ---
# LIVEKIT_URL and LIVEKIT_NODE_IP both use this machine's LAN IP so a physical
# iOS device (and the Simulator) on the same Wi-Fi can reach it. If this Mac's
# LAN IP changes (new network, DHCP renewal), update both (`ipconfig getifaddr en0`).
LIVEKIT_URL=ws://<your-mac-lan-ip>:7880
# Passed to the container as --node-ip: under Docker Desktop the server would
# otherwise advertise the container's own unreachable 172.x address.
LIVEKIT_NODE_IP=<your-mac-lan-ip>
# The only place these live — docker-compose.yml feeds them to the container as
# LIVEKIT_KEYS; livekit.yaml has no keys: section.
# Generate a pair with: echo "APIkv$(openssl rand -hex 8): $(openssl rand -base64 36 | tr -d '\n=+/' | cut -c1-48)"
LIVEKIT_API_KEY=replace-with-your-own-key
LIVEKIT_API_SECRET=replace_with_your_own_secret_min_32_chars

# --- LLM: any OpenAI-compatible chat completions endpoint ---
# Ollama Cloud (OpenAI-compatible). Create a key at https://ollama.com/settings/keys
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b

# --- Speech: two servers, one URL each ---
# STT on scripts/stt-server.sh (:8001), TTS on the mlx-audio server
# (scripts/speech-server.sh, :8000). Both values below are also the built-in defaults,
# so they are here to be seen rather than because they must be set.
STT_BASE_URL=http://localhost:8001/v1
TTS_BASE_URL=http://localhost:8000/v1
# Where stt_server.py listens. Change it and STT_BASE_URL together.
STT_SERVER_PORT=8001

# Omi Med STT v1 (q8): a medical fine-tune of nvidia/parakeet-tdt-0.6b-v2 -- FastConformer
# TDT/RNNT, 0.6B, English only, with a rank-128 adapter after each Conformer block. Chosen
# for domain accuracy: ~97.6% medical-term recall and 8.61% WER on the vendor's 7.18 h
# clinical benchmark (8.59% at full precision, so q8 costs 0.02 points and 1.5 GB). Same
# transducer family as the Nemotron it replaces, so it still returns an *empty* transcript
# on room noise rather than inventing "Thank you." -- the blocklist in agent.py is unchanged.
#
# Two real costs: English only, and a medical bias on ordinary speech.
#
# mlx-audio CANNOT serve this model -- it has no route for the repo id, and the medical
# adapter has to be patched in before the weights load -- which is why stt_server.py exists.
#
# Swapping to a general model is one line -- point STT_MODEL at one of these and set
# STT_BACKEND below to match:
#   mlx-community/nemotron-3.5-asr-streaming-0.6b   multilingual, general, ~0.23 s
#   mlx-community/parakeet-tdt-0.6b-v3              English only, fastest, ~0.07 s
#   mlx-community/whisper-large-v3-asr-fp16         multilingual, most robust, ~0.92 s
# See README.md -> "Swapping models".
STT_MODEL=omi-health/omi-med-stt-v1-mlx-q8

# Optional: which runtime stt_server.py loads. Defaults to `omi`, so it is here to be
# discoverable rather than because it must be set.
#   omi         the vendor runtime, medical adapter and all. The only one with no
#               alternative -- nothing else can load these weights.
#   parakeet    parakeet-mlx directly
#   mlx-audio   mlx-audio's own router; `whisper` and `nemotron` are aliases for it,
#               since it picks the architecture from the repo's config either way
# scripts/stt-server.sh reads the same value and installs only that backend's deps.
#
# The server runs either way -- scripts/dev.sh starts it unconditionally, so STT_BASE_URL
# always has something listening. (It used to be conditional on this variable, which made
# deleting the line fail as a connection refused on the first turn instead of at startup.)
#STT_BACKEND=omi
# Inert for the model above (English only, no language conditioning; stt_server.py ignores
# the field). Load-bearing again the moment STT_MODEL goes back to Nemotron or Whisper.
STT_LANGUAGE=en
# Medical-term post-correction (drug_lexicon.py): misheard drug *and* condition names in the
# final transcript are snapped onto the closest name in these lists, one name per line. The
# transducer above has no hotword biasing, so this is the only lever for vocabulary it did
# not learn. Multiple files, ':'-separated; all three load by default (~4100 names, ~3 ms an
# utterance). Set it empty (`MEDICAL_LEXICON=`) to turn it off. Corrections log at INFO as
# "medical lexicon: ...".
#MEDICAL_LEXICON=data/drugs.txt:data/ingredients.txt:data/conditions.txt
# Read medical terms back to the user when the lexicon recovered them from consonants alone
# (the "spine" tier -- the weakest evidence it acts on). Recognition is never perfect, so this
# turns a silent wrong drug name into a caught one, the way spoken medication orders are
# confirmed in practice. Off by default: it changes how the agent talks, and exact or close
# matches never trigger it, so leaving it on only costs a question on genuinely doubtful turns.
#MEDICAL_CONFIRM=1
# Optional streaming model for live (interim) transcripts, served by mlx-audio's /v1/realtime
# on the TTS server. Display only: STT_MODEL above still produces what the LLM reads. See
# README.md -> "Interim transcripts". ~2.5 GB download on first use; leave empty to skip.
#INTERIM_STT_MODEL=mlx-community/Voxtral-Mini-4B-Realtime-2602-4bit
TTS_MODEL=mlx-community/Kokoro-82M-bf16
TTS_VOICE=af_heart

# --- Token server (token_server.py) ---
TOKEN_SERVER_PORT=8787
# Required by clients as: Authorization: Bearer <this value>
# Generate one with: openssl rand -hex 24
TOKEN_SERVER_AUTH_TOKEN=
