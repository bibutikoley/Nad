# --- LiveKit server (docker-compose.yml runs it in dev mode with these keys) ---
# LIVEKIT_URL uses this machine's LAN IP so a physical iOS device on the same
# Wi-Fi can reach it. Update if this Mac's LAN IP changes (`ipconfig getifaddr en0`).
LIVEKIT_URL=ws://192.168.0.228:7880
# Must match the `keys:` entry in livekit.yaml (cp livekit.yaml.example livekit.yaml
# and fill in both with the same generated pair; see that file for a one-liner).
LIVEKIT_API_KEY=replace-with-your-own-key
LIVEKIT_API_SECRET=replace_with_your_own_secret_min_32_chars

# --- LLM: any OpenAI-compatible chat completions endpoint ---
# Ollama Cloud (OpenAI-compatible). Create a key at https://ollama.com/settings/keys
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b

# --- Speech: mlx-audio server (scripts/speech-server.sh), serves both STT and TTS ---
SPEECH_BASE_URL=http://localhost:8000/v1
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
STT_LANGUAGE=en
TTS_MODEL=mlx-community/Kokoro-82M-bf16
TTS_VOICE=af_heart

# --- Token server (token_server.py) ---
TOKEN_SERVER_PORT=8787
# Required by clients as: Authorization: Bearer <this value>
# Generate one with: openssl rand -hex 24
TOKEN_SERVER_AUTH_TOKEN=
